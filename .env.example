# ---------------------------------------------------------------------------
# Namuna konfiguratsiya. Nusxa oling: cp .env.example .env
# Belgisi (*) bo'lgan o'zgaruvchilar MAJBURIY — ularsiz loyiha ishga tushmaydi.
# ---------------------------------------------------------------------------

# (*) Django maxfiy kaliti. Yangi qiymat generatsiya qilish:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Ishlab chiqarishda albatta False
DEBUG=True

# "production" bo'lsa PostgreSQL + HTTPS sozlamalari yoqiladi.
# Boshqa har qanday qiymatda SQLite ishlatiladi.
ENVIRON=local

# Vergul bilan ajratilgan hostlar. DEBUG=False bo'lganda bo'sh qoldirib bo'lmaydi.
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS va CSRF uchun ruxsat etilgan manbalar (sxema bilan birga, vergul bilan).
TRUSTED_ORIGINS=http://localhost:3000

# (*) Telegram bot tokeni. Import vaqtida o'qiladi — bo'sh bo'lsa `manage.py` ham ishlamaydi.
BOT_TOKEN=123456:change-me

# --- PostgreSQL (faqat ENVIRON=production bo'lganda o'qiladi) ---------------
DB_NAME=hikvision
DB_USER=hikvision
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_CONN_MAX_AGE=300
DB_SSLMODE=disable

# --- Redis -----------------------------------------------------------------
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
# Bo'sh bo'lsa natija saqlanmaydi
CELERY_RESULT_BACKEND=
CELERY_TASK_SOFT_TIME_LIMIT=600
CELERY_TASK_TIME_LIMIT=660

# --- Loglar ----------------------------------------------------------------
LOG_LEVEL=INFO
# Bo'sh bo'lsa faqat konsolga yoziladi. To'ldirilsa 10 MB dan keyin aylanadi.
LOG_FILE=
